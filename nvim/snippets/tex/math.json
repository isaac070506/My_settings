{
    "MathInLine$": {
        "prefix": "mil",
        "body": ["\\$ $0 \\$"],
        "description": "Math in line"
    },
    "MathInBlock": {
        "prefix": "mib",
        "body": [
            "\\[",
            "\t$0",
            "\\]"
        ],
        "description": "Math in Block"
    },
    "fraction": {
        "prefix": [ "\\frac", "frac" ],
        "body": ["\\frac{$1}{$2}"],
        "description": "fraction"
    },
    "dfraction": {
        "prefix": [ "\\dfrac", "dfrac" ],
        "body": ["\\dfrac{$1}{$2}"],
        "description": "dfraction"
    },
    "PartialDev": {
        "prefix": ["pdv", "\\pdv"],
        "body": ["\\pdv[${1:1}]{$2}{$3}"],
        "description": "Partial Derivation"
    },
    "OrdinaryDev": {
        "prefix": ["odv", "\\odv"],
        "body": ["\\odv[${1:1}]{$2}{$3}"],
        "description": "Ordinary Derivation"
    },
    "Matrix": {
        "prefix": ["matrix"],
        "body": [
            "\\begin{bmatrix}",
            "\t$0",
            "\\end{bmatrix}"
            ],
        "description": "To add a matrix"
    },
    "Matrix+": {
        "prefix": ["matrix+"],
        "body": [
            "\t\\left[",
            "\t\\begin{array}{${1:columns}}",
            "\t\t$0",
            "\t\\end{array}",
            "\t\\right]"
            ],
        "description": "To add a matrix with an augmented part"
    }
}
