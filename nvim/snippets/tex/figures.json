{
    "includegraphics": {
        "prefix": ["\\includegraphics"],
        "body": [
            "\\begin{figure}[$1]",
            "\t\\includegraphics[$2\\textwidth]{$0}",
            "\\end{figure}"
        ],
        "description": "Include graphics"
    },
    "Table": {
        "prefix": ["table"],
        "body": [
            "\\begin{table}[H]",
            "\t\\begin{tabular}{${1:colums}}",
            "\t\t$0",
            "\t\\end{tabular}",
            "\\end{table}"
            ],
        "description": "Add a table"
    },
    "F90Prompt": {
        "prefix": ["\\f90"],
        "body": ["\\fcode[codetitle={$1}, label=$2]{${3:path}}"],
        "description": "Add a F90 listings environment"
    },
    "PythonPrompt": {
        "prefix": ["\\py"],
        "body": ["\\pycode[codetitle={$1}, label=$2]{${3:path}}"],
        "description": "Add a python listings environment"
    },
    "CodeOutput": {
        "prefix": ["\\out"],
        "body": ["\\codeoutput[label=$1]{${2:title}}{${3:path}}"],
        "description": "Add the output from a code"
    }
}
