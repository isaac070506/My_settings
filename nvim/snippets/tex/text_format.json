{
    "bold": {
        "prefix": ["bf", "\\textbf"],
        "body": ["\\textbf{$1}"],
        "description": "Bold Text"
    },
    "italic": {
        "prefix": ["it", "\\textit"],
        "body": ["\\textit{$1}"],
        "description": "Italic Text"
    },
    "mono": {
        "prefix": ["tt", "\\texttt"],
        "body": ["\\texttt{$1}"],
        "description": "Monospaced Text"
    }
}
